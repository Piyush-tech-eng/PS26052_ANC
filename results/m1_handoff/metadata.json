{
    "dataset": "module_1_to_module_2_handoff",
    "sampling_rate_hz": 16000,
    "duration_seconds": 5.0,
    "num_samples": 80000,
    "reference_signal": {
        "type": "white_noise",
        "random_seed": 42
    },
    "system": {
        "type": "FIR",
        "impulse_response": [
            0.1,
            0.15,
            0.25,
            0.3,
            0.25,
            0.15,
            0.1
        ],
        "filter_length": 7
    },
    "desired_signal": {
        "definition": "desired[n] = system_impulse_response * reference[n]"
    },
    "module_2_contract": {
        "reference_file": "reference.npy",
        "desired_file": "desired.npy",
        "ground_truth_system_file": "system_impulse_response.npy"
    },
    "verification": {
        "reference_and_desired_same_length": true,
        "sampling_rates_match": true,
        "all_samples_finite": true,
        "fir_convolution_verified": true
    }
}